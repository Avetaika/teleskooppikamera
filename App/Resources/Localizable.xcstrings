            "value": "SYNTEETTINEN"
          }
        }
      }
    },
    "Seuranta päälle ja hidas nopeustaso (3–4). Napauta kirkasta tähteä ristikon lähellä ja paina Kalibroi. Tee sitten kuten ruutu käskee: tatti ylös, STOP, tatti oikealle, STOP.": {
      "extractionState": "manual",
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuranta päälle ja hidas nopeustaso (3–4). Napauta kirkasta tähteä ristikon lähellä ja paina Kalibroi. Tee sitten kuten ruutu käskee: tatti ylös, STOP, tatti oikealle, STOP."
          }
        }
      }
    },
    "Siirrä kirkas tähti ristikon lähelle (alle 40 % säteestä).": {
      "extractionState": "manual",
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
